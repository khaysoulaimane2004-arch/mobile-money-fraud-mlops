# Virtual environment
.venv/
venv/
env/

# Model artifacts (joblib format — too heavy for Git)
*.joblib

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Jupyter notebooks checkpoints
.ipynb_checkpoints/

# Environment variables — never commit secrets
.env
.env.local

# Test files created during development
test_legit.json
test_fraud.json

# MLflow local runs
mlruns/
mlartifacts/

# Data files — too large for Git
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Reports generated by Evidently
reports/drift/*.html
!reports/drift/.gitkeep

# OS files
.DS_Store
Thumbs.db
desktop.ini

# VS Code
.vscode/

# Model files already tracked via model.json
# model.json and model_metadata.json are small enough to keep in Git