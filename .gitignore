# Données et modèles (trop volumineux pour Git)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
models/*
!models/.gitkeep
*.csv
*.pkl
*.joblib

# MLflow
mlruns/
mlartifacts/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# Env / secrets
.env
*.json
!package.json
service-account-key.json

# Docker
*.log

# Rapports générés (gros fichiers HTML)
reports/drift/*.html
!reports/drift/.gitkeep

# OS
.DS_Store
